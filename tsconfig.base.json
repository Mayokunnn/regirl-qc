{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@regirl/types": ["packages/types/src"],
      "@regirl/config": ["packages/config/src"],
      "@regirl/db": ["packages/db/src"],
      "@regirl/ai": ["packages/ai/src"],
      "@regirl/storage": ["packages/storage/src"],
      "@regirl/utils": ["packages/utils/src"]
    }
  }
}
