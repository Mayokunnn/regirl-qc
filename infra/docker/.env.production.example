NODE_ENV=production
PORT=3000
VITE_API_URL=https://api.qc.naturalgirlwigs.com
API_BASE_URL=https://api.qc.naturalgirlwigs.com
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Postgres
POSTGRES_USER=regirl
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_URL=postgresql://regirl:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/regirl_qc

# Redis
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=CHANGE_THIS
MINIO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
STORAGE_PROVIDER=s3
STORAGE_BUCKET=regirl-qc
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=CHANGE_THIS
STORAGE_SECRET_KEY=CHANGE_THIS_STRONG_PASSWORD
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=3600

# AI keys
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=

WORKER_CONCURRENCY=2
